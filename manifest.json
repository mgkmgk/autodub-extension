{
  "manifest_version": 3,
  "name": "VideoDubber TR - Canlı Video Dublaj",
  "version": "1.0.0",
  "description": "YouTube ve Netflix videolarını gerçek zamanlı olarak doğal yapay zeka sesiyle Türkçe seslendirir.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://*.netflix.com/*",
    "http://127.0.0.1:5000/*",
    "https://translate.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "https://*.netflix.com/*"
      ],
      "all_frames": false,
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
